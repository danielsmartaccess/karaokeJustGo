# =============================================================================
# Just Go Karaoke — variáveis de ambiente
# Copie para .env e preencha. NUNCA commite o .env real.
# Apenas variáveis com prefixo VITE_ são expostas ao frontend.
# =============================================================================

# URL do projeto Supabase (ex.: https://xxxxxxxx.supabase.co)
VITE_SUPABASE_URL=

# Chave pública (anon/publishable) do Supabase. NUNCA use a service_role aqui.
VITE_SUPABASE_ANON_KEY=

# Slug do venue padrão desta implantação (FASE 3). Nunca hardcode o id do venue no
# código — cada implantação aponta para o seu venue via esta variável.
VITE_DEFAULT_VENUE_SLUG=armazem-anita
