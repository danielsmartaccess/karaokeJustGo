# =============================================================================
# Karaokê Just Go — variáveis de ambiente
# Copie para .env e preencha. NUNCA commite o .env real.
# Apenas variáveis com prefixo VITE_ são expostas ao frontend.
# =============================================================================

# URL do projeto Supabase (ex.: https://xxxxxxxx.supabase.co)
# Sem estas duas variáveis o app roda em MODO DEMO: estado só na memória da aba,
# com dados de demonstração. Serve para aula e desenvolvimento offline.
VITE_SUPABASE_URL=

# Chave pública (anon/publishable) do Supabase. NUNCA use a service_role aqui.
VITE_SUPABASE_ANON_KEY=

# Slug da sala de karaokê desta implantação. Cada bar/evento usa o seu.
# Padrão: just-go
VITE_KARAOKE_ROOM_SLUG=just-go

# Comandas: 'true' usa o banco real (SÓ depois de aplicar as migrations *_comandas_*
# e de criar o primeiro gerente; ver docs/COMANDAS.md, seção 14). Qualquer outro
# valor, ou ausente, mantém o modo de demonstração (dados fictícios no navegador).
VITE_COMANDAS_LIVE=

# Opcional. Chave da YouTube Data API v3 para a busca real de versões karaokê.
# Sem ela, a busca cai no catálogo local de demonstração.
# ATENÇÃO: toda variável VITE_ vai para o bundle público. Se usar esta, restrinja
# a chave por referenciador HTTP e apenas à YouTube Data API v3 no Google Cloud.
VITE_YOUTUBE_API_KEY=

# Opcional, só no build. Caminho público onde o app é servido; começa e termina
# com "/". Sem prefixo VITE_ de propósito: só o vite.config.ts lê, não vai ao bundle.
# Padrão: /karaokeJustGo/ (GitHub Pages). Na Vercel o app vive na raiz: BASE_PATH=/
# BASE_PATH=/
