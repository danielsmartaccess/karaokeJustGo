# =============================================================================
# Karaokê Just Go — variáveis de ambiente
# Copie para .env e preencha. NUNCA commite o .env real.
# Apenas variáveis com prefixo VITE_ são expostas ao frontend.
# =============================================================================

# URL do projeto Supabase (ex.: https://xxxxxxxx.supabase.co)
# Sem estas duas variáveis o app roda em MODO DEMO: estado só na memória da aba,
# com dados de demonstração. Serve para aula e desenvolvimento offline.
VITE_SUPABASE_URL=

# Chave pública (anon/publishable) do Supabase. NUNCA use a service_role aqui.
VITE_SUPABASE_ANON_KEY=

# Slug da sala de karaokê desta implantação. Cada bar/evento usa o seu.
# Padrão: just-go
VITE_KARAOKE_ROOM_SLUG=just-go

# Opcional. Chave da YouTube Data API v3 para a busca real de versões karaokê.
# Sem ela, a busca cai no catálogo local de demonstração.
VITE_YOUTUBE_API_KEY=
